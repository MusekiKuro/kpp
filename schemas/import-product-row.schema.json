{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nurset.local/schemas/import-product-row.schema.json",
  "title": "Nurset normalized import product row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_type",
    "source_reference",
    "source_hash",
    "external_id",
    "sku",
    "slug",
    "category_slug",
    "brand_slug",
    "name_ru",
    "name_kk",
    "short_description_ru",
    "short_description_kk",
    "description_ru",
    "description_kk",
    "price_mode",
    "price_amount",
    "old_price_amount",
    "currency",
    "stock_status",
    "publication_status",
    "publish_ru",
    "publish_kk",
    "translation_status_kk",
    "is_featured",
    "image_url"
  ],
  "properties": {
    "source_type": {
      "type": "string",
      "enum": ["xlsx", "csv", "json", "text_agent"]
    },
    "source_reference": {
      "type": ["string", "null"],
      "maxLength": 2048
    },
    "source_hash": {
      "type": ["string", "null"],
      "maxLength": 128
    },
    "external_id": {
      "type": ["string", "null"],
      "maxLength": 200
    },
    "sku": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "slug": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 120
    },
    "category_slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 120
    },
    "brand_slug": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 120
    },
    "name_ru": { "type": "string", "minLength": 1, "maxLength": 200 },
    "name_kk": { "type": ["string", "null"], "maxLength": 10000 },
    "short_description_ru": { "type": ["string", "null"], "maxLength": 10000 },
    "short_description_kk": { "type": ["string", "null"], "maxLength": 10000 },
    "description_ru": { "type": ["string", "null"], "maxLength": 10000 },
    "description_kk": { "type": ["string", "null"], "maxLength": 10000 },
    "price_mode": {
      "type": "string",
      "enum": ["request", "exact", "from", "hidden"]
    },
    "price_amount": {
      "type": ["number", "null"],
      "minimum": 0.01,
      "maximum": 999999999999.99,
      "multipleOf": 0.01
    },
    "old_price_amount": {
      "type": ["number", "null"],
      "minimum": 0.01,
      "maximum": 999999999999.99,
      "multipleOf": 0.01
    },
    "currency": { "const": "KZT" },
    "stock_status": {
      "type": "string",
      "enum": ["unknown", "in_stock", "on_order", "out_of_stock"]
    },
    "publication_status": {
      "type": "string",
      "enum": ["draft", "published", "archived"]
    },
    "publish_ru": { "type": "boolean" },
    "publish_kk": { "type": "boolean" },
    "translation_status_kk": {
      "type": "string",
      "enum": ["missing", "ai_draft", "verified"]
    },
    "is_featured": { "type": "boolean" },
    "image_url": {
      "type": ["string", "null"],
      "pattern": "^https?://",
      "maxLength": 2048
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "price_mode": { "enum": ["exact", "from"] }
        }
      },
      "then": {
        "required": ["price_amount"],
        "properties": {
          "price_amount": {
            "type": "number",
            "minimum": 0.01,
            "multipleOf": 0.01
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "price_mode": { "enum": ["request", "hidden"] }
        }
      },
      "then": {
        "properties": {
          "price_amount": { "type": ["number", "null"] }
        }
      }
    },
    {
      "if": {
        "properties": {
          "translation_status_kk": { "enum": ["missing", "ai_draft"] }
        }
      },
      "then": {
        "properties": {
          "publish_kk": { "const": false }
        }
      }
    },
    {
      "if": {
        "properties": {
          "old_price_amount": { "type": "number" }
        }
      },
      "then": {
        "properties": {
          "price_amount": { "type": "number" }
        }
      }
    }
  ]
}
